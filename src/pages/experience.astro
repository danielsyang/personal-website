---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import JobRow from "../components/JobRow.astro";
import { experience } from "../data/experience";
---

<Layout
  title="Experience | Daniel Yang"
  description="Daniel Yang's work history at Replicant, Openscreen, Otto Intelligence, Shipa, SkipTheDishes and iCasei."
>
  <Section number="03" title="Experience"
    as="h1">
    {experience.map((job) => <JobRow {...job} />)}
  </Section>
</Layout>
