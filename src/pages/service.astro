---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";

const services = [
  "Build a web app or MVP from scratch. I was the first engineer at Otto Intelligence.",
  "Set up cloud infrastructure on AWS, defined in code with Terraform or CDK",
  "Integrate Stripe payments",
  "Migrate a JavaScript codebase to TypeScript",
  "Build real-time features like chat",
];

const link = "underline underline-offset-[3px] hover:opacity-70";
---

<Layout
  title="Freelance services | Daniel Yang"
  description="Freelance web and cloud development by Daniel Yang: full-stack TypeScript, AWS infrastructure and Stripe integrations."
>
  <Section number="02" title="Services"
    as="h1">
    <div class="flex flex-col gap-6 max-w-[760px]">
      <p class="font-serif text-4xl leading-[1.25] text-pretty">
        I take on freelance work building <em>full-stack web apps</em> and the cloud
        infrastructure behind them.
      </p>
      <p class="text-lg leading-[1.6] text-body">
        Most of what I do is full-stack TypeScript: React front ends, Node.js
        back ends, and the AWS infrastructure to run them. Things I've done
        before and can do for you:
      </p>
      <ul class="text-lg leading-[1.6] text-body">
        {
          services.map((service) => (
            <li class="py-3.5 border-t border-rule last:border-b">{service}</li>
          ))
        }
      </ul>
      <p class="text-lg leading-[1.6] text-body">
        If that sounds like what you need, <a class={link} href="/contact"
          >send me a message</a
        >.
      </p>
    </div>
  </Section>
</Layout>
