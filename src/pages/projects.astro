---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ProjectTile from "../components/ProjectTile.astro";
import { projects } from "../data/projects";
---

<Layout
  title="Projects | Daniel Yang"
  description="Projects by Daniel Yang: web apps built at Otto Intelligence, plus a Rust interpreter and a terminal to-do app."
>
  <Section number="04" title="Projects"
    as="h1">
    <div class="grid grid-cols-2 gap-x-10 gap-y-12 max-[900px]:grid-cols-1">
      {projects.map((project) => <ProjectTile {...project} />)}
    </div>
  </Section>
</Layout>
