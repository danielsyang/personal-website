---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ContactMeForm from "../components/ContactMeForm";
---

<Layout
  title="Contact | Daniel Yang"
  description="Contact Daniel Yang about freelance software development, cloud infrastructure or a new project."
>
  <Section number="05" title="Contact"
    as="h1">
    <div class="flex flex-col gap-6 max-w-[760px]">
      <p class="font-serif text-4xl leading-[1.25] text-pretty">
        Have a project in mind, or just want to <em>say hi?</em>
      </p>
      <p class="text-lg leading-[1.6] text-body">
        Send me a message and I'll get back to you within a day or two.
      </p>
      <ContactMeForm client:only="solid" />
    </div>
  </Section>
</Layout>
