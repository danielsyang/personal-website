---
import { Picture } from "astro:assets";
import githubLogo from "../logos/github-mark.svg";
import linkedinLogo from "../logos/linkedin-svgrepo-com.svg";
import Selfie from "../images/selfie.jpeg";

interface Props {
  hideDescription?: boolean;
}

const { hideDescription } = Astro.props;

const socials = [
  { href: "https://github.com/danielsyang", logo: githubLogo, label: "GitHub" },
  {
    href: "https://www.linkedin.com/in/shuyangchang/",
    logo: linkedinLogo,
    label: "LinkedIn",
  },
];
---

<div class="lg:w-1/2 w-full px-4">
  <div class="flex">
    <Picture
      src={Selfie}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[200, 350, 700]}
      sizes="(min-width: 1024px) 350px, 100px"
      alt="Photo of Daniel Yang"
      class="rounded-full lg:w-[350px] lg:h-[350px] w-[100px]"
    />
    <div class="ml-4 lg:hidden">
      <h3 class="text-2xl mb-2 text-zinc-600">Daniel Yang</h3>
      <h5 class="text-xs text-zinc-600">
        Senior Software Engineer at Openscreen Inc.
      </h5>
    </div>
  </div>
  <h3 class="text-4xl mb-2 text-zinc-600 mt-8 hidden lg:block">Daniel Yang</h3>
  <h5 class="text-lg mb-2 text-zinc-600 hidden lg:block">
    Senior Software Engineer at Openscreen Inc.
  </h5>
  {
    !hideDescription && (
      <p class="text-xs md:text-sm text-zinc-400 lg:max-w-sm mt-4">
        I build accessible, inclusive products and digital experiences for the
        web.
      </p>
    )
  }

  <div class="flex mt-6 lg:mt-10 gap-4 mb-4">
    {
      socials.map(({ href, logo, label }) => (
        <a href={href}>
          <img src={logo.src} alt={label} width="24" height="24" />
        </a>
      ))
    }
  </div>
</div>
