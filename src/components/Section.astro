---
interface Props {
  id?: string;
  number: string;
  title: string;
  /** Use "h1" when the section is the page's main heading. */
  as?: "h1" | "h2";
}

const { id, number, title, as: Heading = "h2" } = Astro.props;
---

<section
  id={id}
  class="flex flex-col gap-10 py-20 px-16 border-t border-rule first:border-t-0 max-[900px]:px-6"
>
  <Heading class="font-serif text-[40px] text-accent">
    {`${number} `}<span class="text-ink">{title}</span>
  </Heading>
  <div>
    <slot />
  </div>
</section>
